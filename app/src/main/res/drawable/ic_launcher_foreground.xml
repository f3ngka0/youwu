        <!-- 日历主体（210,430 604×440 r52） -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M262,430 L762,430 A52,52 0 0 1 814,482 L814,818 A52,52 0 0 1 762,870 L262,870 A52,52 0 0 1 210,818 L210,482 A52,52 0 0 1 262,430 Z" />

        <!-- 日历挂环 ×2（竖胶囊 48×92 r24） -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M302,402 A24,24 0 0 1 326,426 L326,470 A24,24 0 0 1 302,494 A24,24 0 0 1 278,470 L278,426 A24,24 0 0 1 302,402 Z" />
        <path
            android:fillColor="#FFFFFFFF"
