        <!-- 课表块 ×3（蓝，同背景色，170×64 r20） -->
        <path
            android:fillColor="#FF174B8E"
            android:pathData="M300,560 L430,560 A20,20 0 0 1 450,580 L450,604 A20,20 0 0 1 430,624 L300,624 A20,20 0 0 1 280,604 L280,580 A20,20 0 0 1 300,560 Z" />
