        <path
            android:fillColor="#FF174B8E"
            android:pathData="M425,750 L555,750 A20,20 0 0 1 575,770 L575,794 A20,20 0 0 1 555,814 L425,814 A20,20 0 0 1 405,794 L405,770 A20,20 0 0 1 425,750 Z" />
